{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "app.e2e-spec.ts"],
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(\\.pnpm/).*(nanoid|uuid|image-dimensions|marked|happy-dom|slugify|tiptap|prosemirror|exceljs|fast-csv|papaparse|katex|dompurify|linkedom|jsdom|undici|cheerio|htmlparser2|parse5|entities|whatwg-mimetype|data-urls|encoding-sniffer|http-link-header|css-select|boolbase|nth-check|domhandler|domutils|cheerio-select))/"
  ],
  "moduleNameMapper": {
    "^@docmost/db/(.*)$": "<rootDir>/../src/database/$1",
    "^@docmost/transactional/(.*)$": "<rootDir>/../src/integrations/transactional/$1",
    "^@docmost/ee/(.*)$": "<rootDir>/../src/ee/$1",
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@docmost/base-formula/server$": "<rootDir>/../../../packages/base-formula/src/index.server.ts",
    "^@docmost/base-formula/client$": "<rootDir>/../../../packages/base-formula/src/index.client.ts"
  }
}
