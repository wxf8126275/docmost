# Cloud Drive (网盘) configuration
#
# In this design a "drive" is simply a Space of type `spaces.type = 'drive'`.
# Access is governed per-space by member roles (reader / writer / admin) — there
# is no separate personal/shared drive model and no personal-drive auto-creation.

# Per-space storage quota. Parsed by `bytes` (e.g. 10gb, 500mb, 1tb).
# Leave empty / 0 to impose no limit. Quota is aggregated per `spaceId`.
DRIVE_STORAGE_QUOTA=
